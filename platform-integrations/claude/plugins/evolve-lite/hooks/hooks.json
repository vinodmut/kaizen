{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/skills/recall/scripts/retrieve_entities.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "agent",
            "prompt": "Check if .evolve/config.toml exists and has auto_learn = false — if so, skip. Otherwise run the evolve-lite:learn skill, unless stop_hook_active is set in $ARGUMENTS.",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
